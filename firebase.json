{
  "hosting": [
    {
      "target": "portfolio",
      "public": "build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**/*.@(otf|ttf)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(js|json|html|wasm)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "portfolio-redirect",
      "public": "redirect_site",
      "redirects": [
        {
          "regex": "^/((?:[^f]|f[^l]).*)?$",
          "destination": "https://mohamedbenhmida-portfolio.web.app/:1",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ],
  "flutter": {
    "platforms": {
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "mohamedbh-portfolio",
          "configurations": {
            "web": "1:383340589858:web:f611ce50a3a140e876eb7b"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}